# ~/dsai-vault/.env on the server. `deploy install` writes it with freshly generated
# secrets, readable by its owner only. This file only shows its shape. Never commit a
# real one.

# The address visitors use. Django answers to this name and no other.
PUBLIC_HOST=dsai3.pages.dev

# Signs sessions and CSRF tokens. Changing it logs everyone out.
DJANGO_SECRET_KEY=

# Shared with the Cloudflare proxy (edge/_worker.js), which sends it on every request.
# Change it in both places together.
ORIGIN_SECRET=

# The Docker network of the web server that owns ports 80/443 on this machine; the proxy
# joins it. `deploy install` finds it and writes this line.
FRONT_NETWORK=
